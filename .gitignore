# =============================================
# gemini-wilgat .gitignore
# =============================================

# Build output directories
target/
build/
build-win/
builddir/
gemini-wilgat

# Vendored clone used only while installing sol2 headers
sol2-temp/

# WebKit runtime cache from local runs
.cache/
.local/

# Binary executables
gemini-wilgat
gemini_wilgat
*.exe

# =============================================
# Autotools / GNU Make generated files
# =============================================
Makefile
Makefile.in
Makefile.am
configure
configure.ac
config.h.in
config.log
config.status
config.cache
stamp-h1
aclocal.m4
autom4te.cache/
compile
depcomp
install-sh
missing
configure~

# Object files and dependencies
*.o
*.lo
*.la
.deps/
.dirstamp

# Source-level generated files
src/main/cpp/.deps/
src/main/cpp/.dirstamp
src/main/cpp/*.o

# =============================================
# Gradle files
# =============================================
.gradle/
build/
out/
gradlew
gradlew.bat
.gradle-wrapper/

# Gradle cache
.caches/

# =============================================
# Ant / Maven style (just in case)
# =============================================
build.xml~
*.class

# =============================================
# Temporary and editor files
# =============================================
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# IDE / Editor directories
.vscode/
.idea/
*.iml
.project
.settings/
.eclipse/

# Logs
*.log
logs/

# =============================================
# Design Documents
# =============================================
docs/knowledge-base
docs/requirement
docs/playbook

# =============================================
# CIAO / Project specific
# =============================================
# Ignore backup files
*.bak
*.backup

# =============================================
# Comments
# =============================================
# This .gitignore is designed to cover:
# - Simple GCC build (target/)
# - GNU Make / Autotools
# - Gradle builds
# - Ant builds
# - Common editor and temporary files